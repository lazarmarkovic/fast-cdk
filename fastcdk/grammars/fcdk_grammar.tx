// -----------------------------------------------------------------------------
// fastcdk_fcdk_grammar.tx
// -----------------------------------------------------------------------------


// top‐level model: zero or more definitions
Model:
    definitions*=Definition
;

// each Definition binds a name to a resource‐type block
Definition:
    name=ID "="
    type=ID
    "{"
      statements*=Statement
    "}"
;

// inside a block you can have either assignments or bare references
Statement:
      Assignment
    | Reference
;

// key = value
Assignment:
    key=ID "=" value=Value
;

// just a name pointing to another Definition
Reference:
    ref=ID
;

// simple scalars or hyphenated tokens
Value:
      BOOL
    | FLOAT
    | INT
    | PATH  // catches things like eu-west-1 or climbing-app-dev
    | ID
;

// -------------------------------------------------------------------
// terminals
// -------------------------------------------------------------------
BOOL:  "true" | "false" ;

// PATH: letters, digits, underscore, dash, dot or slash
PATH:  /[A-Za-z0-9_\-\.\/]+/ ;

Comment: /#[^\n]*/ ;