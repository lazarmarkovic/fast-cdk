Model:
  instances*=Instance
;

Instance:
    StackInstance
  | SubstackInstance
  | OtherInstances
;

StackInstance:
  assigned_name=ID "=" "stack"
  "{"
      aws_account_id=AwsAccountId
      aws_region=AwsRegion
      aws_stack_name=AwsStackName
      project=Project
      exe_env=ExeEnv
      
      children*=Child
  "}"
;
AwsAccountId: "aws_account_id" "=" val=AWSAccountIdForm;
AwsRegion: "aws_region" "=" val=AWSRegionForm;
AwsStackName: "aws_stack_name" "=" val=Value;
Project: "project" "=" val=Value;
ExeEnv: "exe_env" "=" val=Value;


SubstackInstance:
  assigned_name=ID "=" "substack"
  "{"
    id_prefix=IdPrefixAssign
    name_prefix=NamePrefixAssign
    class_prefix=ClassPrefixAssign
    class_name=ClassNameAssign

    children*=Child
  "}"
;
IdPrefixAssign: "id_prefix" "=" val=Value;
NamePrefixAssign: "name_prefix" "=" val=Value;
ClassPrefixAssign: "class_prefix" "=" val=Value;
ClassNameAssign: "class_name" "=" val=Value;


Child: name=ID;


OtherInstances:
    assigned_name=ID "=" def_name=ID
    "{"
      inputs*=InputAssign
    "}"
;
InputAssign: key=ID "=" val=Value;



AWSAccountIdForm: /\d{12}/ ;
AWSRegionForm: /(us|af|ap|ca|cn|eu|il|me|sa)(-[a-z]+)+-\d+/ ;
Value:
      FLOAT
    | INT
    | BOOL
    | PATH
    | ID
    | NULL
;

BOOL:  "true" | "false" ;
NULL:  "null" ;
PATH: /[A-Za-z0-9_\-\.\/\\:]+/ ;

Comment: /#[^\n]*/ ;