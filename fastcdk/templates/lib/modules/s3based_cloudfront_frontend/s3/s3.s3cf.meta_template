s3_bucket_for_cloudfront: Submodule {

  template_file = s3.s3cf.template
  place = s3based-cloudfront-frontend/s3.s3cf.ts

  env_vars {
    s3BucketNameEnvVar = BuildParams.S3BasedCF.S3BucketName = my-frontend-bucket
    cloudFrontConnectionSecretEnvVar = BuildParams.S3BasedCF.CloudFrontConnectionSecret
  }

  default_input {
    idPrefix = S3cf
    namePrefix = s3cf
    classPrefix = null
    className = FrontendS3Bucket
  }
}
