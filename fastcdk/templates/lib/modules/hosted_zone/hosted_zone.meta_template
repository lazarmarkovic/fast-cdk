hosted_zone {
  template_file = hosted_zone.template
  default_place = root/hosted-zone.root.ts

  deps {}

  env_vars {
    baseDomainNameEnvVar = BuildParams.Root.BaseDomainName = some:ARN:of:AWS
  }

  default_input {
    project = MyProject
    exe_env = null
    idPrefix = Root
    namePrefix = root
    classPrefix = null
    className = HostedZone
  }
}