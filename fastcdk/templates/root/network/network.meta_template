name < Simple Network With NAT
template file < network.template

env
  envConfig.BuildParams.Root.VpcCidr < 10.0.0.0/16

deps
  none

input
  idPrefix < Root
  namePrefix < root
  classPrefix < null
  
  maxAzs < 3
  natGateways < 1
  enableDnsSupport < true
  enableDnsHostnames < true

  addPublicSubnet < true
  addPrivateWithEgressSubnet < false
  addPrivateIsolatedSubnet < false

  addS3Endpoint < true

  enumExample < enum T2 | T3 | T4 < T3
  