# Test Network Template stuff

climbing_app = stack {
  aws_account_id = 111111111111
  aws_region = eu-west-1
  aws_stack_name = ClimbingAppDev
  project = climbing-app-dev
  exe_env = staging

  s3_cf


  network_1
}


s3_cf = s3_based_cloudfront_full_frontend {
  cloudfront.class_name = S3RandomCF

  mhz1
  main_git_oidc_from_resource

}

s3_cf2 = s3_based_cloudfront_full_frontend {
  mhz1
  main_git_oidc_from_resource
}


mhz1 = main_hosted_zone {
  base_domain_name = BuildParams.Root.BaseDomainName1
}

main_git_oidc_from_resource = git_oidc_from_resource {
  gen_path = /s3based-cloudfront-frontend
}


network_1 = network_with_nat {
  enable_dns_support = true # When we don't set any param, default values are being used
}