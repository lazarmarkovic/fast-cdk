{% if render_class_def %}
// External imports
import * as cdk from "aws-cdk-lib";
import * as iam from "aws-cdk-lib/aws-iam";

// Config imports
import { EnvConfig } from "@base/config/configSchema";


export class {{class_name}} {
  public readonly oidcProvider: iam.IOpenIdConnectProvider;

  constructor(
    mainStack: cdk.Stack,
    envConfig: EnvConfig,
  ) { 
    this.oidcProvider = iam.OpenIdConnectProvider.fromOpenIdConnectProviderArn(
      mainStack,
      "{{id_prefix}}OpenIdConnectProvider`,
      envConfig.{{open_id_connect_provider_arn}}
    );
  }
}
{%- else -%} new {{class_name}}(mainStack, envConfig);
{% endif %}