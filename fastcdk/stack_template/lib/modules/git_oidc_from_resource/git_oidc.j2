{% if render_class_def %}
// External imports
import * as cdk from "aws-cdk-lib";
import * as iam from "aws-cdk-lib/aws-iam";

// Config imports
import { EnvConfig } from "@fastcdk-root/config/configSchema";


export class {{this.class_name}} {
  public readonly oidcProvider: iam.IOpenIdConnectProvider;

  constructor(
    mainStack: cdk.Stack,
    envConfig: EnvConfig,
  ) { 
    this.oidcProvider = iam.OpenIdConnectProvider.fromOpenIdConnectProviderArn(
      mainStack,
      "{{this.id_prefix}}OpenIdConnectProvider`,
      envConfig.{{this.open_id_connect_provider_arn}}
    );
  }
}
{%- else -%} 
new {{this.class_name}}(this, envConfig);
{%- endif -%}