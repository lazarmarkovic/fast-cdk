git_oidc_from_resource {

  templates {
    git_oidc.j2 = git_oidc.root.ts
  }

  deps {}

  env_vars {
    open_id_connect_provider_arn = BuildParams.Root.OpenIdConnectProviderARN = myOpenIdConnectProviderARN
  }

  default_inputs {
    path = /
    id_prefix = Root
    name_prefix = root
    class_prefix = null
    class_name = GitOidcRoot
  }
}
