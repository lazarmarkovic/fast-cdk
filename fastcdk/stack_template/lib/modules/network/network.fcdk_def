network_with_nat {

  templates {
    this {
      template_file = network.j2
      gen_path = .
      gen_file_name = network.root.ts

      var_name = network
      class_name = Network
      id_prefix = Root
      name_prefix = root
    }
  }

  deps {}

  env_vars {
    vpc_cidr = BuildParams.Root.VpcCidr = 10.0.0.0/16
  }

  default_inputs {    
    max_azs = 3
    nat_gateways = 1
    enable_dns_support = true
    enable_dns_host_names = true

    add_public_subnet = true
    add_private_with_egress_subnet = false
    add_private_isolated_subnet = false

    add_s3_endpoint = true
  }
}