{% if render_class_def %}
// External imports
import * as cdk from "aws-cdk-lib";
import * as ecr from "aws-cdk-lib/aws-ecr";

// Config imports
import { EnvConfig } from "@base/config/configSchema";


export class {{class_name}} {
  public readonly ecrRepo: ecr.IRepository;
  public readonly containerName: string

  constructor(
    mainStack: cdk.Stack,
    envConfig: EnvConfig,
  ) {
    this.ecrRepo = ecr.Repository.fromRepositoryArn(
      mainStack,
      "{{id_prefix}}EcrRepo",
      envConfig.{{ecr_repo_arn}}
    );
    this.containerName = "{{name_prefix}}-container";

    // Tag resources
    cdk.Tags.of(this.ecrRepo).add("Name", "{{name_prefix}}.ecr-repo");
  }
}
{%- else -%} new {{class_name}}(mainStack, envConfig);
{% endif %}