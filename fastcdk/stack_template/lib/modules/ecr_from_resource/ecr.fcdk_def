ecr_from_resource {

  templates {
    ecr {
      template_file = ecr.j2
      gen_path = /
      gen_file_name = ecr.root.ts

      var_name = ecr
      class_name = Ecr
      id_prefix = Root
      name_prefix = root
    }
  }

  deps {}

  env_vars {
    ecr_repo_arn = BuildParams.Root.EcrRepoARN = some:ARN:of:AWS
  }

  default_inputs {
  }
}