hosted_zone {

  templates {
    hosted_zone.j2 = hosted-zone.root.ts
  }

  deps {}

  env_vars {
    base_domain_name = BuildParams.Root.BaseDomainName = some:ARN:of:AWS
  }

  default_inputs {
    path = /
    id_prefix = Root
    name_prefix = root
    class_prefix = null
    class_name = HostedZone
  }
}