hosted_zone {

  templates {
    this {
      template_file = hosted_zone.j2
      gen_path = /
      gen_file_name = hosted-zone.root.ts

      var_name = hostedZone
      class_name = HostedZone
      id_prefix = Root
      name_prefix = root
    }
  }

  deps {}

  env_vars {
    base_domain_name = BuildParams.Root.BaseDomainName = some:ARN:of:AWS
  }

  default_inputs {
  }
}