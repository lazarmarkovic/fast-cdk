s3_based_cloudfront_git_oidc_role {

  template_file = por.s3cf.template
  place = /s3based-cloudfront-frontend/por.s3cf.ts

  deps {
    git_oidc_from_resource
    s3_based_cloudfront
    main_hosted_zone
    s3_bucket_for_cloudfront # u koliko koristi isti naziv uzima referencu na postojeci ne pravi novi osim ako nije napravljen sa "custom_name = meta_tempalte oblikom"
  }

  env_vars {
    gitOwnerEnvVar = BuildParams.Root.GitOwner = git-user-or-org-name
    gitRepoNameEnvVar = BuildParams.S3BasedCF.GitRepoName = git-repo-name
    gitRepoPullBranchName = BuildParams.S3BasedCF.GitRepoPullBranchName = git-pull-branch-name
  }

  default_input {
    idPrefix = S3cf
    namePrefix = s3cf
    classPrefix = null
    className = GitOidcRole
  }
}