{% if is_class_def %}
// External imports
import * as cdk from "aws-cdk-lib";
import * as iam from "aws-cdk-lib/aws-iam";
import * as codedeploy from "aws-cdk-lib/aws-codedeploy";

// Config imports
import { EnvConfig } from "../../config/configSchema";

// Root imports
import { {{git_oidc_from_resource.class}} } from "../{{git_oidc_from_resource.path}}";

// Local imports
import { {{s3_bucket_for_cloudfront.class}} } from "../{{s3_bucket_for_cloudfront.path}}";
import { {{s3_based_cloudfront.class}} } from "../{{s3_based_cloudfront.path}}";


export class {{id_prefix}}{{class_prefix}}{{class_name}} {
  public readonly codeDeployApp: codedeploy.ServerApplication;
  public readonly deploymentGroup: codedeploy.ServerDeploymentGroup;
  public readonly gitPlatformActionsRole: iam.Role;

  constructor(
    mainStack: cdk.Stack,
    envConfig: EnvConfig,

    rootGitOidc: {{git_oidc_from_resource.class}},
    s3: {{s3_bucket_for_cloudfront.class}},
    scfCloudFront: {{s3_based_cloudfront.class}},
  ) {
    this.gitPlatformActionsRole = new iam.Role(mainStack, "{{id_prefix}}GitPlatformActionsDeployRole", {
      roleName: "{{name_prefix}}.github-actions-deploy-role",
      assumedBy: new iam.FederatedPrincipal(
        rootGitOidc.oidcProvider.openIdConnectProviderArn,
        {
          "StringEquals": {
            "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
            "token.actions.githubusercontent.com:sub": `repo:${envConfig.{{git_owner}}}/${envConfig.{{git_repo_name}}}:ref:refs/heads/${envConfig.{{git_repo_pull_branch_name}}}`,
          },
        },
        "sts:AssumeRoleWithWebIdentity"
      ),

      maxSessionDuration: cdk.Duration.hours(1),
    });


    this.gitPlatformActionsRole.addToPolicy(new iam.PolicyStatement({
      actions: [
        "cloudfront:CreateInvalidation",
      ],
      resources: [`arn:aws:cloudfront::${mainStack.account}:distribution/${scfCloudFront.cfDist.distributionId}`],
    }));
    this.gitPlatformActionsRole.addToPolicy(new iam.PolicyStatement({
      actions: [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      resources: [`arn:aws:s3:::${s3.frontendBucket.bucketName}/*`],
    }));
    this.gitPlatformActionsRole.addToPolicy(new iam.PolicyStatement({
      actions: ["s3:ListBucket"],
      resources: [`arn:aws:s3:::${s3.frontendBucket.bucketName}`],
    }));


    // Outputs - generated after deployment
    new cdk.CfnOutput(mainStack, "{{id_prefix}}OutGitPlatformActionsRoleArn", {
      description: "FA ARN of the GitHub OIDC IAM Role",
      value: this.gitPlatformActionsRole.roleArn
    });

    new cdk.CfnOutput(mainStack, "{{id_prefix}}OutS3BucketName", {
      description: "FA S3 Bucket Name",
      value: s3.frontendBucket.bucketName
    });

    new cdk.CfnOutput(mainStack, "{{id_prefix}}OutCfDistributionId", {
      description: "FA CloudFront Distribution ID",
      value: scfCloudFront.cfDist.distributionId
    });
  }
}
{%- elif is_constr_def -%} new {{id_prefix}}{{class_prefix}}{{class_name}}(
  mainStack, 
  envConfig,

  this.{{ git_oidc_from_resource.instance_name }},
  this.{{ s3_bucket_for_cloudfront.instance_name }},
  this.{{ s3_based_cloudfront.instance_name }},
);
{% endif %}