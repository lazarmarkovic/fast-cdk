s3_based_cloudfront_full_frontend {

  template_file = main.s3cf.template
  default_path = s3based-cloudfront-frontend/main.s3cf.ts

  deps {
    main_hosted_zone from root
    git_oidc_from_resource from root

    s3_bucket_for_cloudfront from this
    s3_based_cloudfront from this
    s3_based_cloudfront_git_oidc_role from this
  }

  env_vars {}

  default_inputs {
    id_prefix = S3cf
    name_prefix = s3cf
    class_prefix = null
    class_name = Main
  }
}
