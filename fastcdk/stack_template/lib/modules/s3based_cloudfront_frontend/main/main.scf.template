{% if data.isClassDef %}
// External imports
import * as cdk from "aws-cdk-lib";

// Config import
import { EnvConfig } from "../../config/configSchema";
import { DeploymentEnvEnum } from "../../mics/deploymentEnvEnum";

// Root imports
import { {{data.main_hosted_zone.class}} } from "../{{data.main_hosted_zone.place}}";
import { {{data.git_oidc_from_resource.class}} } from "../{{data.git_oidc_from_resource.place}}";

// Local imports
import { {{data.s3_bucket_for_cloudfront.class}} } from "../{{data.s3_bucket_for_cloudfront.place}}";
import { {{data.s3_based_cloudfront.class}} } from "../{{data.s3_based_cloudfront.place}}";
import { {{data.s3_based_cloudfront_git_oidc_role.class}} } from "../{{data.s3_based_cloudfront_git_oidc_role.place}}";


export class {{data.idPrefix}}{{data.classPrefix}}{{data.className}} {
  public readonly {{data.s3_bucket_for_cloudfront.instance_name}}: {{data.s3_bucket_for_cloudfront.class}};
  public readonly {{data.s3_based_cloudfront.instance_name}}: {{data.s3_based_cloudfront.class}};
  public readonly {{data.s3_based_cloudfront_git_oidc_role.instance_name}}: {{data.s3_based_cloudfront_git_oidc_role.class}};

  constructor(
    mainStack: cdk.Stack,
    envConfig: EnvConfig,
    {{data.main_hosted_zone.instance_name}}: {{data.main_hosted_zone.class}},
    {{data.git_oidc_from_resource.instance_name}}: {{data.git_oidc_from_resource.class}},
  ) {
    // App frontend S3 bucket
    this.{{data.s3_bucket_for_cloudfront.instance_name}} = new {{data.s3_bucket_for_cloudfront.class}}(mainStack, envConfig);


    // CloudFront holder
    this.{{data.s3_based_cloudfront.instance_name}} = new {{data.s3_based_cloudfront.class}}(
      mainStack,
      envConfig,
      {{data.main_hosted_zone.instance_name}},
      this.{{data.s3_bucket_for_cloudfront.instance_name}},
    );

    // GitHub Actions OIDC role
    this.{{data.s3_based_cloudfront_git_oidc_role.instance_name}} = new {{data.s3_based_cloudfront_git_oidc_role.class}}(
      mainStack,
      envConfig,
      {{data.git_oidc_from_resource.instance_name}},
      this.{{data.s3_bucket_for_cloudfront.instance_name}},
      this.{{data.s3_based_cloudfront.instance_name}},
    );
  }
}
{%- elif if data.isConstructor -%} new {{data.idPrefix}}{{data.classPrefix}}{{data.className}}(
  mainStack, 
  envConfig,

  this.{{ data.git_oidc_from_resource.instance_name }},
  this.{{ data.s3_bucket_for_cloudfront.instance_name }},
  this.{{ data.s3_based_cloudfront.instance_name }},
);
{% endif %}