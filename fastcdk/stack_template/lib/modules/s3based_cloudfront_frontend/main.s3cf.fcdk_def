s3_based_cloudfront_full_frontend {

  templates {
    this {
      template_file = main.s3cf.j2
      gen_path = s3based-cloudfront-frontend
      gen_file_name = main.s3cf.ts

      var_name = s3cfFrontend
      class_name = S3cfFrontend
      id_prefix = S3cf
      name_prefix = s3cf-frontend
    }

    cloudfront {
      template_file = cloudfront.s3cf.j2
      gen_path = s3based-cloudfront-frontend
      gen_file_name = cloudfront.s3cf.ts

      var_name = s3cfCloudfront
      class_name = S3cfCloudfront
      id_prefix = S3cf
      name_prefix = s3cf-frontend
    }

    oidc_roles {
      template_file = oidc_roles.s3cf.j2
      gen_path = s3based-cloudfront-frontend
      gen_file_name = oidc_roles.s3cf.ts

      var_name = s3cfOidcRoles
      class_name = S3cfOidcRoles
      id_prefix = S3cf
      name_prefix = s3cf-frontend
    }

    s3_bucket {
      template_file = s3_bucket.s3cf.j2
      gen_path = s3based-cloudfront-frontend
      gen_file_name = s3_bucket.s3cf.ts

      var_name = s3cfS3Bucket
      class_name = S3cfS3Bucket
      id_prefix = S3cf
      name_prefix = s3cf-frontend
    }
  }

  deps {
    main_hosted_zone = hosted_zone {
      var_name = hostedZone
      class_name = HostedZone
    }

    git_oidc_from_resource
  }


  env_vars {
    # for cloudfront.s3cf.j2
    domain_name = BuildParams.Root.DomainName = test.com
    cloudfront_connection_secret = BuildParams.S3BasedCF.CloudFrontConnectionSecret = my-secret-string
    cloudfront_certificate_arn = BuildParams.S3BasedCF.CloudFrontCertificateARN = my-cf-cert

    # for por.s3cf.j2
    git_owner = BuildParams.Root.GitOwner = git-user-or-org-name
    git_repo_name = BuildParams.S3BasedCF.GitRepoName = git-repo-name
    git_repo_pull_branch_name = BuildParams.S3BasedCF.GitRepoPullBranchName = git-pull-branch-name

    # for s3.s3cf.j2
    s3_bucket_name = BuildParams.S3BasedCF.S3BucketName = my-frontend-bucket
    cloudfront_connection_secret = BuildParams.S3BasedCF.CloudFrontConnectionSecret = some-secret-string
  }

  default_inputs {

  }
}
