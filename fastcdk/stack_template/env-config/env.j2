{%- macro keep_begin(id, sig) -%}# fastcdk:keep-start id={{ id }} sig={{ sig }}{%- endmacro -%}
{%- macro keep_end() -%}# fastcdk:keep-end{%- endmacro -%}
{% set VERSION_SIGNATURE = 'v0.0.1' %}
# AWS Configuration
AwsStackName = "FastCdkExampleAppDev"
AwsAccountId = "397130095288"
AwsRegion = "eu-west-1"

# Project Information
ProjectName = "fcdk-example"
Environment = "dev"
Version = "1.0.0"

{{ keep_begin("OtherYamlVars", VERSION_SIGNATURE) }}
{{ keep_end() }}
{# templates/config_toml.j2 #}
{% macro emit_table(node, path, before=False) -%}
{%- set leaves = [] -%}
{%- set objects = [] -%}
{%- for key, child in node|dictsort -%}
  {%- if child.__leaf__ -%}{% set _ = leaves.append((key, child)) %}
  {%- else -%}{% set _ = objects.append((key, child)) %}{%- endif -%}
{%- endfor -%}

{# header with optional blank line before it (skip for very first) #}
{%- if path|length > 0 -%}
{%- if before -%}{{ '\n' -}}{%- endif -%}
[{{ path|join('.') }}]{{ '\n' -}}
{{ keep_begin("OtherYamlVars", VERSION_SIGNATURE) }}
{{ keep_end() }}
{%- endif %}

{# key = "value" leaves #}
{%- for key, child in leaves -%}
{{ key }} = "{{ child.value
  | replace('\\', '\\\\')
  | replace('"', '\\"')
}}"{{ '\n' -}}
{%- endfor -%}

{# recurse into child objects; mark all as not-first=false? true to force blank line #}
{%- for key, child in objects -%}
{{ emit_table(child, path + [key], True) -}}
{%- endfor -%}
{%- endmacro -%}

{{ emit_table(tree, [], False) }}

