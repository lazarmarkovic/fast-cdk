//////////////////////////////////
/////////////// Definition Grammar
Fcdk:
    fcdk = Definitions
  | fcdk = Instances
;

Definitions: 
  definitions*=SingleDefinition
;

SingleDefinition:
  name=ID "{"
    template_map=TemplateMapSection
    deps=DependencyMapSection?
    env_vars=EnvVarMapSection?
    default_inputs=DefaultInputMapSection?
  "}"
;

///////////////////////
// Stuff for Template
TemplateMapSection:
  "templates" "{" 
    entries*=SingleTemplate
  "}"
;
SingleTemplate: 
  template_name=ID "{"  
    template_file=TemplateFileAssign 
    gen_path=GenPathAssign
    gen_file_name=GenFileNameAssign

    var_name=VarNameAssign
    class_name=ClassNameAssign
    id_prefix=IdPrefixAssign
    name_prefix=NamePrefixAssign
  "}"  
;
TemplateFileAssign: "template_file" "=" val=FileName ;
GenPathAssign: "gen_path" "=" val=PATH ;
GenFileNameAssign: "gen_file_name" "=" val=FileName ;
VarNameAssign: "var_name" "=" val=ID ;
ClassNameAssign: "class_name" "=" val=ID ;
IdPrefixAssign: "id_prefix" "=" val=ID ;
NamePrefixAssign: "name_prefix" "=" val=/[\w-]+/ ;


///////////////////////
// Stuff for Deps
DependencyMapSection:
  "deps" "{"
    entries*=SingleDependency
  "}"
;
SingleDependency:
    assigned_name=ID "=" def_name=ID ( "{" inputs+=SingleGeneralInputAssign "}" )?
  | assigned_name=ID
;
SingleGeneralInputAssign: 
    key=ID "=" "_" "=" ref_val=PATH
  | key=ID "=" ref=RefPath "=" val=PATH
  | key=ID "=" ref=RefPath
  | key=ID "=" val=Value
  | template_name=ID "." template_field=TemplateField
;
TemplateField:
    TemplateFileAssign
  | GenPathAssign
  | GenFileNameAssign
  | VarNameAssign
  | ClassNameAssign
  | IdPrefixAssign
  | NamePrefixAssign
;



///////////////////////
// Stuff for Env Vars
EnvVarMapSection:
  "env_vars" "{"
    entries*=SingleEnvVar
  "}"
;

SingleEnvVar: key=ID "=" ref=RefPath "=" val=PATH ;
RefPath: first=ID "." rest+=ID["."] ;



///////////////////////
// Stuff for Default Inputs
DefaultInputMapSection:
  "default_inputs" "{"
    inputs*=DefaultInputAssign
  "}"
;
DefaultInputAssign:
  key=ID "=" val=PATH
;


////////////////////////////////
////////////////////////////////
/////////////// Instance Grammar
Instances:
    instances*=SingleInstance
;

SingleInstance:
  stack_instance=SingleStackInstance
  other_instances*=SingleOtherInstance
;

SingleStackInstance:
  stack_name=ID "=" "stack"
  "{"
      inputs*=SingleGeneralInputAssign
      children*=Child
  "}"
;
Child: name=ID ;


SingleOtherInstance:
  assigned_name=ID "=" target_name=ID
  "{"
    inputs*=SingleGeneralInputAssign
    dep_overrides*=DepOverride
  "}"
;
DepOverride: name=ID ;


////////////////////////////////
/////////////// Common matchings
FileName: /[\w-]+(\.[\w-]+)+/ ;
PATH: /[A-Za-z0-9_\-\.\/\\:]+/ ;
Value:
      FLOAT
    | INT
    | BOOL
    | PATH
    | ID
    | NULL
;

BOOL:  "true" | "false" ;
NULL:  "null" ;

Comment: /#[^\n]*/ ;