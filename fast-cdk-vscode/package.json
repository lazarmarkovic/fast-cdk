{
  "name": "fast-cdk-vscode",
  "displayName": "FastCDK DSL Support",
  "description": "Syntax highlighting, IntelliSense, and language server for the fastCDK DSL (textX).",
  "version": "0.1.0",
  "publisher": "lazarmarkovic",
  "readme": "README.md",
  "engines": { "vscode": "^1.92.0" },
  "categories": ["Programming Languages"],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:fcdk",
    "onCommand:fastcdk.restartServer"
  ],
  "main": "./dist/src/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazarmarkovic/fast-cdk.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "fcdk",
        "aliases": ["fastCDK", "fcdk"],
        "extensions": [".fcdk", ".fcdk_def"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fcdk",
        "scopeName": "source.fcdk",
        "path": "./syntaxes/fcdk.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "fastCDK",
      "properties": {
        "fastcdk.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter used when calling external fastcdk/textX helpers (optional)."
        },
        "fastcdk.enableExternal": {
          "type": "boolean",
          "default": false,
          "description": "Enable calling an optional external Python helper for deeper validation/completions."
        },
        "fastcdk.externalHelper": {
          "type": "string",
          "default": "",
          "description": "Path to a Python module or script that speaks LSP-like JSON over stdio."
        }
      }
    },
    "commands": [
      {
        "command": "fastcdk.restartServer",
        "title": "fastCDK: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p .",
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "extensionDependencies": [
    "textX.textX"
  ],
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.92.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}