secret_from_resource {

  templates {
    this {
      template_file = secret_from_resource.j2
      gen_path = .
      gen_file_name = secret.root.ts

      var_name = ecsSecret
      class_name = EcsSecret
      id_prefix = Root
      name_prefix = root
    }
  }

  deps {}

  env_vars {
    secret_arn = BuildParams.SimpleECSBackend.SecretARN = SECRET:ARN
  }

  default_inputs {
  }
}